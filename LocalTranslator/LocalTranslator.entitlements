<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox (mantiene la postura de seguridad actual) -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Necesario para descargar el modelo desde Hugging Face -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Acceso de solo lectura a archivos que el usuario elija -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Excepciones de Hardened Runtime requeridas por MLX/Metal (compilación JIT de kernels) -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
